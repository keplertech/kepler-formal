# Minimal downstream consumer of kepler-formal.
#
# Builds the checker exactly the way an external module does: a plain
# bazel_dep, no dev_dependencies. This catches breakage that is invisible
# when this repo is the root module, e.g. labels that only resolve from
# the root module's repo mapping.
#
# kepler-formal's hermetic-llvm toolchain is a dev_dependency and does
# not propagate. A consumer that wants the same hermetic build sets it up
# itself, as here, which also keeps this smoke test independent of the
# CI runner's host compiler.
module(name = "kepler-formal-consumer-test")

bazel_dep(name = "kepler-formal")
local_path_override(
    module_name = "kepler-formal",
    path = "../..",
)

bazel_dep(name = "llvm", version = "0.8.26")

llvm_toolchains = use_extension("@llvm//extensions:toolchain.bzl", "toolchain")
llvm_toolchains.exec(
    arch = "x86_64",
    os = "linux",
)
llvm_toolchains.target(
    arch = "x86_64",
    os = "linux",
)
use_repo(llvm_toolchains, "llvm_toolchains")

register_toolchains("@llvm_toolchains//:all")
