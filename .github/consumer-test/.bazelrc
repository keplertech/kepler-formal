# Same registries as kepler-formal's .bazelrc.
#   cadical 3.0.0                          bazelbuild/bazel-central-registry#10883
common --registry=https://raw.githubusercontent.com/oharboe/bazel-central-registry/cf30c24de5255b58a523064f8a624848b4bd1bab/
common --registry=https://bcr.bazel.build/

common --enable_platform_specific_config

build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20

# Same guard as the root .bazelrc: the hermetic toolchain must win
# resolution.
common:linux --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
build:linux --dynamic_mode=off
