# Root BUILD file for kepler-formal

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

sh_binary(
    name = "release",
    srcs = ["tools/release.sh"],
    data = [
        "MODULE.bazel",
        "//src/bin:KeplerVersion.h.in",
        "mcp/pyproject.toml",
    ],
)

filegroup(
    name = "licenses",
    srcs = ["LICENSE.rst"] + glob(["LICENSES/*"]),
    visibility = ["//packaging:__pkg__"],
)

alias(
    name = "install",
    actual = "//packaging:install",
    visibility = ["//visibility:public"],
)
