load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:naja_includes.bzl", "NAJA_HEADER_COPTS")

cc_test(
    name = "PhaseAnalysisTests",
    srcs = [
        "phase/GeneralizedPhaseAnalysisTests.cpp",
        "phase/NormalizedTransitionSystemTests.cpp",
    ],
    copts = NAJA_HEADER_COPTS,
    deps = [
        "//src/clauses:kepler_clauses",
        "//src/sec:kepler_sec_phase",
        "@naja",
        "@naja//:naja_extra_headers",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "SequentialEquivalenceStrategyTests",
    srcs = ["SequentialEquivalenceStrategyTests.cpp"],
    data = [
        "//examples:testdata",
        "@naja//:ff_scan_lib",
    ],
    env = {
        "NAJA_FF_SCAN_LIB": "$(rootpath @naja//:ff_scan_lib)",
        "TEST_DATA_PREFIX": "",
    },
    size = "large",
    timeout = "long",
    copts = NAJA_HEADER_COPTS,
    deps = [
        "//src/config:kepler_config",
        "//src/sec:kepler_sec",
        "//src/strategies:formal_strategies",
        "@naja",
        "@naja//:naja_extra_headers",
        "@googletest//:gtest_main",
    ],
)
