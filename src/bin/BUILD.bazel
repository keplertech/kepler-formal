load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("//bazel:naja_includes.bzl", "NAJA_HEADER_COPTS")

cc_binary(
    name = "kepler-formal",
    srcs = [
        "KeplerFormal.cpp",
        "KeplerFormalUtils.h",
    ],
    copts = NAJA_HEADER_COPTS,
    linkopts = select({
        "@platforms//os:macos": [
            "-L/opt/homebrew/lib",
            "-L/usr/local/lib",
            "-lcapnp",
            "-lkj",
            "-ltbb",
            "-ltbbmalloc",
            "-lz",
        ],
        "//conditions:default": [
            # Statically link what we can for portable release binaries.
            # Cap'n Proto and libstdc++/libgcc are linked statically.
            # TBB has no static libs (by design) — bundled in release tarball.
            # Naja .so files are also bundled (see release workflow).
            "-static-libstdc++",
            "-static-libgcc",
            "-Wl,-Bstatic",
            "-lcapnp",
            "-lkj",
            "-Wl,-Bdynamic",
            "-ltbb",
            "-ltbbmalloc",
            "-lz",
            "-lpthread",
            "-ldl",
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//src/config:kepler_config",
        "//src/frontend/c:kepler_c_frontend",
        "//src/sec:kepler_sec",
        "//src/scope:scope_extraction",
        "//src/strategies:formal_strategies",
        "@kissat",
        "@naja",
        "@naja//:naja_extra_headers",
        "@spdlog",
        "@yaml-cpp",
    ],
)
