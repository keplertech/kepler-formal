load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

cc_binary(
    name = "kepler-formal",
    srcs = [
        "KeplerFormal.cpp",
        "KeplerFormalUtils.h",
    ],
    linkopts = [
        # Statically link libstdc++/libgcc for portable release binaries.
        # Cap'n Proto, kj, TBB, ZLIB now linked via BCR cc_library deps below.
        # Naja .so files are bundled with the release tarball (see release workflow).
        "-static-libstdc++",
        "-static-libgcc",
        "-lpthread",
        "-ldl",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//src/config:kepler_config",
        "//src/sec:kepler_sec",
        "//src/scope:scope_extraction",
        "//src/strategies:formal_strategies",
        "@capnp-cpp//src/capnp",
        "@capnp-cpp//src/kj",
        "@kissat",
        "@naja",
        "@naja//:naja_extra_headers",
        "@onetbb//:tbb",
        "@onetbb//:tbbmalloc",
        "@spdlog",
        "@yaml-cpp",
        "@zlib",
    ],
)
